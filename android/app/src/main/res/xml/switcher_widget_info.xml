<?xml version="1.0" encoding="utf-8"?>
<!-- 4 x 1 cells (one row of cells holds both tile rows); resizable.
     Redrawn by the app, never polled. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp"
    android:minHeight="60dp"
    android:targetCellWidth="4"
    android:targetCellHeight="1"
    android:minResizeWidth="250dp"
    android:minResizeHeight="60dp"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="0"
    android:initialLayout="@layout/switcher_widget"
    android:previewLayout="@layout/switcher_widget"
    android:description="@string/switcher_widget_description"
    android:widgetCategory="home_screen" />
